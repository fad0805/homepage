ENVIRONMENT=production

# for signin in api container
SECRET_KEY=

# Auth token lifetimes (optional; defaults: access 30 minutes, refresh 30 days)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Grace period for the previous refresh token after rotation (optional; default 60 seconds)
REFRESH_TOKEN_GRACE_SECONDS=60

# for db container
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Postgresql ENV in api container
DB_HOST=
DB_USER=
DB_NAME=
DB_PASS=
DB_PORT=

# Max image upload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# Public site URL used in RSS links (optional; inferred from the request host)
SITE_URL=

# Server-side API URL from the web container (optional; default: http://api:8000)
API_INTERNAL_URL=

# Seconds to cache public page data on the Next.js server (optional; default: 60)
PUBLIC_DATA_REVALIDATE=

# S3 object storage (all uploaded images)
S3_ENDPOINT_URL=
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix for uploaded objects (CDN domain or public bucket URL)
S3_PUBLIC_BASE_URL=
# Object key prefix inside the bucket
S3_KEY_PREFIX=images
# Optional: path | virtual (for S3-compatible storage)
S3_ADDRESSING_STYLE=
# Optional: public-read (leave empty when the bucket policy handles public access)
S3_ACL=
